{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build active C/C++ file",
            "type": "cppbuild",
            "command": "C:\\MinGW\\w64devkit\\bin\\g++.exe",
            "args": [
                "-g",
                "-O0",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-ladvapi32",
                "-lcrypt32"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}